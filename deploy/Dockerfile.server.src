# Packages a locally-built server binary into a minimal runtime image.
# Build on the host first (uses your local cargo cache), then docker compose up.
#
# Build:  cargo build --release -p server
# Run:    docker compose -f docker-compose.postgres.yml up --build

FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY target/release/parental-controller-server /usr/local/bin/screenguard-server

EXPOSE 8080
ENTRYPOINT ["screenguard-server"]
